# Copy to .env for local development:  cp .env.example .env
# No real AWS keys here, ever. Use `aws configure sso` / profiles instead.
AWS_REGION=us-east-1
AWS_PROFILE=portfolio-dev

# Pipeline Lambda settings (set by Terraform in AWS; set by the tests locally)
TABLE_NAME=processed-orders
MAX_FILE_BYTES=5242880

# Compliance remediation stays in dry-run unless explicitly changed
REMEDIATION_DRY_RUN=true
